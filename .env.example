# ═══ IoT Stack — คัดลอกเป็น .env แล้วแก้ค่า (ห้าม commit .env) ═══
# บน VPS: chmod 600 .env  · สร้างค่าด้วย `openssl rand -hex 32`

TZ=Asia/Bangkok

# ── Node-RED ──────────────────────────────────────────────
NODERED_USERNAME=admin
# สร้าง hash: npx bcryptjs "your-password" 8
# ใน .env ต้อง escape $ → $$ ทุกตัว  (เช่น $$2b$$08$$xxxxxxxx...)
NODERED_PASSWORD_HASH=CHANGE_ME_BCRYPT_HASH_WITH_DOLLARS_ESCAPED

# ── n8n + Postgres ────────────────────────────────────────
# openssl rand -hex 16
N8N_ENCRYPTION_KEY=CHANGE_ME_RANDOM_HEX
# URL ที่ใช้เปิด n8n (ผ่าน tunnel ปล่อยว่างได้ = http://localhost:5678/)
N8N_PUBLIC_URL=http://localhost:5678/
POSTGRES_USER=n8n
POSTGRES_PASSWORD=CHANGE_ME_RANDOM_PASSWORD
POSTGRES_DB=n8n

# ── InfluxDB (init เฉพาะตอน volume ว่าง) ──────────────────
INFLUXDB_USERNAME=admin
INFLUXDB_PASSWORD=CHANGE_ME_RANDOM_PASSWORD
INFLUXDB_ORG=iot_org
INFLUXDB_BUCKET=iot_bucket
# openssl rand -hex 32
INFLUXDB_ADMIN_TOKEN=CHANGE_ME_RANDOM_HEX

# ── Grafana ───────────────────────────────────────────────
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=CHANGE_ME_RANDOM_PASSWORD

# ── Cloudflare Tunnel (profile "extra" เท่านั้น; VPS ต้องสร้าง tunnel ใหม่) ──
CLOUDFLARE_TUNNEL_TOKEN=
